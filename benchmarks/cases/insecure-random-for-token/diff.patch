@@ -7,5 +7,13 @@ package auth
 import (
 	"math/rand"
 )
 
+func NewResetToken() string {
+	b := make([]byte, 32)
+	for i := range b {
+		b[i] = charset[rand.Intn(len(charset))]
+	}
+	return string(b)
+}
+
 const charset = "abcdefghijklmnopqrstuvwxyz0123456789"
