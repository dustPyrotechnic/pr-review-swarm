  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "//test": "先清 .build：每个 vitest worker 会各自打一份 bundle，而进程级的 exit 钩子在 worker 线程结束时不触发，反复本地跑会攒下若干 1.3MB 的死文件。",
    "test": "rm -rf .build && vitest run",
    "evaluate": "node run-evaluation.mjs"
  },
